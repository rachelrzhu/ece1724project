generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum RecipeVisibility {
  PRIVATE
  PUBLIC
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum DietPreference {
  NONE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  GLUTEN_FREE
  DAIRY_FREE
  EGG_FREE
}

enum Allergen {
  MILK
  EGG
  PEANUT
  TREE_NUT
  SESAME
  SOY
  WHEAT_TRITICALE
  FISH
  CRUSTACEANS_MOLLUSCS
  MUSTARD
  SULPHITES
}

enum IngredientDiet {
  VEGAN
  VEGETARIAN
  NON_VEGETARIAN
  NON_VEGAN
  UNKNOWN
  MEAT
  SEAFOOD
}

// Preserve the existing profile table. Authentication records are added separately.
model User {
  id        String       @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String       @unique(map: "users_username_unique") @default("")
  usernameChangeAvailableAt DateTime? @map("username_change_available_at") @db.Timestamptz(6)
  email     String       @unique(map: "users_email_unique")
  name      String?
  emailVerified Boolean @default(false) @map("email_verified")
  image     String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions  Session[]
  accounts  Account[]
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  files     StoredFile[]
  recipes   Recipe[]
  bookmarks Bookmark[]
  reactions RecipeReaction[]
  dietarySettings DietarySettings?

  @@map("users")
}

model DietarySettings {
  userId   String         @id @map("user_id") @db.Uuid
  diet     DietPreference @default(NONE)
  allergens Allergen[]    @default([])
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("dietary_settings")
}

model IngredientProfile {
  canonicalName  String               @id @map("canonical_name") @db.VarChar(160)
  classification IngredientDiet
  containsGluten Boolean?             @map("contains_gluten")
  allergens      IngredientAllergen[]
  recipeIngredients RecipeIngredient[]
  translation    IngredientTranslation?
  aliases        IngredientAlias[]

  @@map("ingredient_profiles")
}

model IngredientTranslation {
  canonicalName String            @id @map("canonical_name") @db.VarChar(160)
  en            String            @db.VarChar(160)
  zh            String            @db.VarChar(160)
  fr            String            @db.VarChar(160)
  ingredient    IngredientProfile @relation(fields: [canonicalName], references: [canonicalName], onDelete: Cascade, onUpdate: Cascade)

  @@map("ingredient_translations")
}

model IngredientAlias {
  name          String            @id @db.VarChar(160)
  canonicalName String            @map("canonical_name") @db.VarChar(160)
  ingredient    IngredientProfile @relation(fields: [canonicalName], references: [canonicalName], onDelete: Cascade, onUpdate: Cascade)

  @@index([canonicalName])
  @@map("ingredient_aliases")
}

model IngredientAllergen {
  canonicalName String            @map("canonical_name") @db.VarChar(160)
  allergen      Allergen
  ingredient    IngredientProfile @relation(fields: [canonicalName], references: [canonicalName], onDelete: Cascade, onUpdate: Cascade)

  @@id([canonicalName, allergen])
  @@map("ingredient_allergens")
}

model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token String @unique
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
}

model Account {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String @map("account_id")
  providerId String @map("provider_id")
  userId String @map("user_id") @db.Uuid
  accessToken String? @map("access_token")
  refreshToken String? @map("refresh_token")
  idToken String? @map("id_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope String?
  password String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([identifier])
  @@map("verifications")
}

model StoredFile {
  id          String   @id(map: "files_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  pathname    String   @unique(map: "files_pathname_unique")
  contentType String   @map("content_type")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "files_owner_id_users_id_fk")
  coverOf     Recipe?

  @@index([ownerId], map: "files_owner_id_idx")
  @@map("files")
}

model Recipe {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId     String             @map("author_id") @db.Uuid
  title        String             @db.VarChar(160)
  description  String             @db.VarChar(5000)
  baseServings Decimal            @map("base_servings") @db.Decimal(12, 4)
  prepMinutes  Int                @map("prep_minutes")
  cookMinutes  Int                @map("cook_minutes")
  // Generated by PostgreSQL. A zero combined time means the duration is unknown.
  totalMinutes Int?               @map("total_minutes")
  difficulty   RecipeDifficulty
  visibility   RecipeVisibility   @default(PRIVATE)
  // Historical UUID stays on a copy after the source is deleted.
  sourceRecipeId String?          @map("source_recipe_id") @db.Uuid
  coverFileId  String?            @unique @map("cover_file_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cover        StoredFile?        @relation(fields: [coverFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ingredients  RecipeIngredient[]
  steps        RecipeStep[]
  bookmarks    Bookmark[]
  reactions    RecipeReaction[]
  likes        RecipeLike[]

  @@index([authorId, updatedAt])
  @@index([visibility, createdAt, id])
  @@index([totalMinutes])
  @@map("recipes")
}

model MeasurementUnit {
  symbol String @id @db.VarChar(32)
  menuPosition Int? @unique @map("menu_position")
  ingredients RecipeIngredient[]

  @@map("measurement_units")
}

model RecipeIngredient {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId      String   @map("recipe_id") @db.Uuid
  position      Int
  name          String   @db.VarChar(160)
  canonicalName String   @map("canonical_name") @db.VarChar(160)
  quantity      Decimal? @db.Decimal(16, 6)
  unit          String?  @db.VarChar(32)
  note          String?  @db.VarChar(300)
  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipeId, position])
  profile IngredientProfile @relation(fields: [canonicalName], references: [canonicalName], onDelete: Restrict, onUpdate: NoAction)
  measurementUnit MeasurementUnit? @relation(fields: [unit], references: [symbol], onDelete: Restrict, onUpdate: Cascade)

  @@index([canonicalName])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId    String @map("recipe_id") @db.Uuid
  position    Int
  instruction String @db.VarChar(4000)
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipeId, position])
  @@map("recipe_steps")
}

model Bookmark {
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, recipeId])
  @@index([recipeId])
  @@map("bookmarks")
}

model RecipeReaction {
  userId   String  @map("user_id") @db.Uuid
  recipeId String  @map("recipe_id") @db.Uuid
  liked    Boolean
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, recipeId])
  @@index([recipeId])
  @@map("recipe_reactions")
}

// Read-only subset for ordering recipes by positive reactions.
view RecipeLike {
  recipeId String @map("recipe_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  @@unique([userId, recipeId])
  @@map("recipe_likes")
}

model WriteRateLimit {
  policy    String   @db.VarChar(24)
  slot      Int      @db.SmallInt
  used      Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([policy, slot])
  @@map("write_rate_limits")
}
