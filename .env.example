# secret when creating this file or adding a missing key; preserve existing values.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
