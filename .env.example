# Required for database-backed services. The homepage and automated checks can run without it.
DATABASE_URL=
# Direct Neon connection for Prisma CLI migrations; otherwise DATABASE_URL is used.
DIRECT_URL=

# Required for private-image services and the manual storage:check command.
BLOB_READ_WRITE_TOKEN=

# Required for product authentication. Generate a unique secret of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
