{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postman": "postman collection run postman/crud.postman_collection.json --no-report-events --timeout-request 45000",
    "test:postman:production": "postman collection run postman/production-guards.postman_collection.json --no-report-events --timeout-request 45000",
    "check": "npm run db:validate && npm run lint && npm run typecheck && npm test",
    "images:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-cloud-covers.ts",
    "env:check": "tsx scripts/check-env.ts",
    "storage:probe": "node --conditions=react-server --import tsx scripts/probe-storage.ts",
    "storage:check": "node --conditions=react-server --import tsx scripts/check-storage.ts",
    "backend-test:setup": "node --conditions=react-server --import tsx scripts/backend-test.ts setup",
    "backend-test:cleanup": "node --conditions=react-server --import tsx scripts/backend-test.ts cleanup",
    "poc:setup": "node scripts/local-db.mjs",
    "poc:dev": "node scripts/local-db.mjs dev",
    "poc:stop-db": "node scripts/local-db.mjs stop",
    "poc:verify": "node scripts/local-db.mjs verify",
    "poc:cleanup-images": "node scripts/local-db.mjs cleanup-images",
    "poc:start": "node scripts/local-db.mjs start",
    "test:product": "node scripts/check-product.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@material-tailwind/react": "3.0.0-beta.24",
    "@next/env": "16.4.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@reduxjs/toolkit": "2.15.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.18",
    "botid": "1.5.13",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "9.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "1.65.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
