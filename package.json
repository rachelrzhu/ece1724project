{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postman": "postman collection run postman/crud.postman_collection.json --no-report-events --timeout-request 45000",
    "test:postman:production": "postman collection run postman/production-guards.postman_collection.json --no-report-events --timeout-request 45000",
    "check": "npm run db:validate && npm run lint && npm run typecheck && npm test",
    "storage:check": "node --conditions=react-server --import tsx scripts/check-storage.ts",
    "backend-test:setup": "node --conditions=react-server --import tsx scripts/backend-test.ts setup",
    "backend-test:cleanup": "node --conditions=react-server --import tsx scripts/backend-test.ts cleanup"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@next/env": "16.4.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.18",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
